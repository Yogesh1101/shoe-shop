# ---------------------------------------------------------------------------
# Server environment. Copy to `.env` and fill in.
# Every key here is validated at boot by src/config/env.ts — a missing or
# malformed value crashes the server immediately with a readable message,
# rather than failing halfway through someone's checkout.
# NEVER commit the real .env. On Render these go in the dashboard.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# URL of the storefront. Used for CORS and for links inside emails.
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas -----------------------------------------------------------
# Atlas > Database > Connect > Drivers. Remember to URL-encode a password
# containing @ : / or ?. Network access must allow 0.0.0.0/0 for Render's free
# tier, which has no static outbound IP.
MONGODB_URI=mongodb://127.0.0.1:27017/shoe-shop

# --- Admin auth --------------------------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# The single admin account, created by `npm run seed:admin`.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-before-going-live

# --- Cloudinary (shoe photos) ------------------------------------------------
# Cloudinary Console > Dashboard > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ----------------------------------------------------------------
# Test keys work immediately (rzp_test_...). Live keys need KYC approval, which
# requires the policy pages to be live on your domain first.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Settings > Webhooks. Set to any secret you choose, then
# point the webhook at https://<your-api>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Brevo SMTP, 300/day free) ----------------------------------------
# Brevo > SMTP & API > SMTP. SMTP_USER is the login shown there, SMTP_PASS is
# the generated SMTP key (NOT your Brevo account password).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where new-order alerts are sent — i.e. you.
OWNER_EMAIL=owner@example.com
# The From: address. Must be a sender you verified in Brevo.
MAIL_FROM=orders@example.com
