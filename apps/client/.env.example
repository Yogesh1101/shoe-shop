# ---------------------------------------------------------------------------
# Client environment. Copy to `.env` and fill in.
#
# WARNING: every VITE_* variable is baked into the JavaScript bundle and is
# publicly readable. Only ever put non-secret values here. The Razorpay key id
# is designed to be public; the key SECRET must only ever live on the server.
# ---------------------------------------------------------------------------

# Base URL of the API. No trailing slash.
VITE_API_URL=http://localhost:5000

# Razorpay public key id (rzp_test_... or rzp_live_...). Safe to expose.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
